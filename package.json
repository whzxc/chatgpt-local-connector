{
  "name": "@whzxc/chatgpt-local-connector",
  "version": "0.8.17",
  "description": "Personal local MCP connector for ChatGPT and Codex",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "check": "tsc --noEmit -p ui/tsconfig.json",
    "build": "vite build --config vite.config.ts && node tooling/build-native.mjs",
    "cache:prune": "node tooling/prune-build-cache.mjs",
    "pretest": "node tooling/build-plugin.mjs && node tooling/prune-build-cache.mjs",
    "test": "node --test tests/control-mcp.test.ts",
    "posttest": "node tooling/prune-build-cache.mjs --keep=native/target/contracts",
    "check:package": "node tooling/check-package.mjs",
    "dev:ui": "vite --config vite.config.ts",
    "dev": "node tooling/desktop-dev.mjs",
    "desktop:prepare": "node tooling/prepare-desktop.mjs",
    "desktop:build": "node tooling/desktop-build.mjs",
    "predesktop:check": "node tooling/build-native.mjs && node tooling/prune-build-cache.mjs",
    "desktop:check": "cargo check --manifest-path desktop/Cargo.toml",
    "postdesktop:check": "node tooling/prune-build-cache.mjs --keep=desktop/target/debug",
    "check:format": "cargo fmt --manifest-path native/Cargo.toml -- --check && cargo fmt --manifest-path desktop/Cargo.toml -- --check && cargo fmt --manifest-path tooling/verifier/Cargo.toml -- --check",
    "precheck:native": "node tooling/build-native.mjs && node tooling/prune-build-cache.mjs",
    "check:native": "cargo check --manifest-path desktop/Cargo.toml",
    "postcheck:native": "node tooling/prune-build-cache.mjs --keep=desktop/target/debug",
    "release:prepare": "node tooling/release.mjs prepare",
    "release:check": "node tooling/release.mjs check",
    "release:sync": "node tooling/release.mjs sync",
    "release:preflight": "npm run check:format && npm run release:check && npm run check && npm test && npm run build && npm run check:native",
    "release:stage": "node tooling/release.mjs stage",
    "release:finalize": "node tooling/release.mjs finalize",
    "plugin:dev": "node tooling/plugin-dev.mjs",
    "plugin:web": "node tooling/plugin-web-dev.mjs",
    "plugin:marketplace": "node tooling/plugin-marketplace.mjs",
    "plugin:build": "node tooling/plugin-build.mjs",
    "plugin:check": "node tooling/check-plugin.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@radix-ui/themes": "^3.3.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@types/node": "26.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "typescript": "6.0.3",
    "vite": "8.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whzxc/chatgpt-local-connector.git"
  },
  "homepage": "https://github.com/whzxc/chatgpt-local-connector#readme",
  "bugs": {
    "url": "https://github.com/whzxc/chatgpt-local-connector/issues"
  },
  "keywords": [
    "chatgpt",
    "codex",
    "mcp",
    "local",
    "connector"
  ],
  "private": true
}
